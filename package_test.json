{
  "name": "AP_Invoice",
  "version": "1.0.0",
  "description": "AP Invoice",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@langchain/core": "^0.3.80",
    "@langchain/langgraph": "^0.2.0",
    "@sap-ai-sdk/ai-api": "^1.0.0",
    "@sap-ai-sdk/core": "^1.0.0",
    "@sap-ai-sdk/langchain": "^1.0.0",
    "@sap-ai-sdk/orchestration": "^1.0.0",
    "@sap-cloud-sdk/http-client": "^4.2.0",
    "@sap-cloud-sdk/util": "^4.2.0",
    "@sap/cds": "^9",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4.12.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.15.2",
    "body-parser": "^2.2.2",
    "express": "^4",
    "form-data": "^4.0.6",
    "hdb": "^2.26.3",
    "langchain": "^0.3.0",
    "passport": "^0.7.0",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^4.0.0",
    "xml2js": "^0.6.2",
    "zod": "^3.23.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "underscore": "^1.13.8",
    "ajv": "^6.14.0",
    "readdir-glob": {
      "minimatch": "^5.1.8"
    },
    "@ui5/cli": {
      "minimatch": "^3.1.3",
      "ajv": "^6.14.0"
    },
    "tar": "^7.5.16",
    "undici": "^6.27.0",
    "qs": "^6.15.2",
    "js-yaml": "^4.2.0",
    "yaml": "^2.8.3",
    "handlebars": "^4.7.9",
    "lodash": "^4.17.23",
    "fast-xml-parser": "^4.5.5",
    "picomatch": "^4.0.4",
    "brace-expansion": "^2.0.3",
    "@isaacs/brace-expansion": "^5.0.1",
    "@xmldom/xmldom": "^0.8.13",
    "@opentelemetry/core": "^2.8.0",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.0",
    "ip-address": "^10.1.1",
    "markdown-it": "^14.2.0",
    "node-forge": "^1.4.0",
    "langsmith": "^0.6.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "2.1.3",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0",
    "@ui5/linter": "^1.21.1",
    "cds-plugin-ui5": "^0.13.0",
    "eslint": "^10.4.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "watch-configcountry": "cds watch --open configcountry/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-usercountries": "cds watch --open usercountries/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy AP_Invoice --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rm -rf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-ap_invoice_extraction": "cds watch --open apinvoiceextraction/index.html?sap-ui-xx-viewCache=false --livereload false",
    "lint:cds": "cds lint",
    "lint:ui5-extraction": "cd app/ap_invoice_extraction && ui5lint",
    "lint:ui5-configcountry": "cd app/configcountry && ui5lint",
    "lint:ui5-conversion": "cd app/conversionfunctions && ui5lint",
    "lint:ui5-usercountries": "cd app/usercountries && ui5lint",
    "lint:ui5": "npm run lint:ui5-extraction && npm run lint:ui5-configcountry && npm run lint:ui5-conversion && npm run lint:ui5-usercountries",
    "lint": "npm run lint:cds && npm run lint:ui5"
  },
  "private": true,
  "cds": {
    "server": {
      "body_parser": {
        "limit": "100mb"
      },
      "timeout": 300000
    },
    "requires": {
      "gen-ai-hub": {
        "gpt-4o": {
          "destinationName": "AI_Core",
          "deploymentUrl": "/v2/inference/deployments/d5540f01af62cbef",
          "resourceGroup": "ap-invoice",
          "apiVersion": "2024-11-20",
          "modelName": "gpt-4o"
        }
      },
      "AI_Core": {
        "kind": "rest",
        "credentials": {
          "destination": "AI_Core",
          "requestTimeout": "300000"
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "lcap": true,
  "workspaces": [
    "app/*"
  ]
}
