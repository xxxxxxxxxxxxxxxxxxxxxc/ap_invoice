<mvc:View controllerName="conversionfunctions.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m" xmlns:core="sap.ui.core">
    <Page id="pageMain" title="{i18n>appTitle}">
        <content>
            <Table id="table" items="{/ConversionFunctions}" mode="Delete" delete="onDelete">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>appTitle}" level="H2"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://download" text="Export" press="onExport" tooltip="Export to JSON"/>
                        <Button icon="sap-icon://upload" text="Import" press="onImport" tooltip="Import from JSON"/>
                        <Button icon="sap-icon://add" text="{i18n>add}" press="onAdd"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="{i18n>name}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>description}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>serviceUrl}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>destination}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>method}"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press="onPress">
                        <cells>
                            <Text text="{name}"/>
                            <Text text="{description}"/>
                            <Text text="{serviceUrl}"/>
                            <Text text="{destination}"/>
                            <Text text="{method}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
