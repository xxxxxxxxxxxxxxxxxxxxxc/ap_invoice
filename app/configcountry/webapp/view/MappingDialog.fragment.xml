<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="{i18n>titMappingDialog}" class="sapUiContentPadding" contentWidth="60%">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="Configure Mappings for: {currentFieldModel>/fieldName} ({currentFieldModel>/fieldType})" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://add" text="{i18n>add}" press="onAddMappingRow" />
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <Table id="dlgMappingTable" items="{currentFieldModel>/mappings}" mode="Delete" delete="onDeleteMappingRow">
                <columns>
                     <Column width="25%"><Text text="{i18n>colODataField}" /></Column>
                     <Column width="30%"><Text text="Transformation Steps" /></Column>
                     <Column width="10%"><Text text="Group ID" /></Column>
                     <Column width="10%"><Text text="{i18n>colActive}" /></Column>
                     <Column width="12%"><Text text="Group By" /></Column>
                     <Column width="12%"><Text text="Sum" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ComboBox
                                selectedKey="{currentFieldModel>odataField_id}"
                                items="{
                                    path: '/ODataFields',
                                    sorter: { path: 'entityName' },
                                    length: 5000,
                                    templateShareable: true
                                }"
                                width="100%"
                            >
                                <core:Item key="{id}" text="{entityName} : {fieldLabel}" />
                            </ComboBox>

                            <Button 
                                text="Configure Steps ({= ${currentFieldModel>steps} ? ${currentFieldModel>steps}.length : 0 })" 
                                icon="sap-icon://process" 
                                press="onConfigureSteps" 
                            />
                            
                            <Input 
                                value="{currentFieldModel>groupId}" 
                                placeholder="e.g. 1" 
                                type="Number"
                                width="100%"
                            />

                            <CheckBox selected="{currentFieldModel>active}" />

                            <CheckBox selected="{currentFieldModel>aggregationGroupBy}" />

                            <CheckBox selected="{currentFieldModel>aggregationSum}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button text="{i18n>apply}" type="Emphasized" press="onApplyMappingChanges" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press="onCancelMappingDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
