<mvc:View
    controllerName="configcountry.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
>
    <Page
        id="detailPage"
        title="Country Configuration"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <ObjectHeader
                id="objHeaderDetail"
                title="{name}"
                number="{code}"
                intro="Configuration for"
            >
                <attributes>
                    <ObjectAttribute id="objAttrDesc" text="{description}" />
                </attributes>
            </ObjectHeader>

            <IconTabBar id="idIconTabBar" expanded="true" class="sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter id="itfSchema" text="Schema &amp; Metadata" key="upload">
                        <VBox id="vboxSchema" class="sapUiSmallMargin">
                            <Panel id="panelSchema" headerText="1. Document AI Schema (JSON)" width="auto" class="sapUiResponsiveMargin">
                                <content>
                                    <l:VerticalLayout id="vlSchema">
                                        <Text id="txtSchemaInstr" text="Upload the JSON schema from SAP Document Information Extraction to populate available fields." class="sapUiSmallMarginBottom"/>
                                        <u:FileUploader
                                            id="fileUploaderSchema"
                                            name="schemaUpload"
                                            uploadUrl=""
                                            tooltip="Upload JSON Schema"
                                            fileType="json"
                                            placeholder="Select JSON Schema file..."
                                            style="Emphasized"
                                        />
                                        <Button
                                            id="btnLoadSchema"
                                            text="Load Schema"
                                            press="onUploadSchema"
                                            type="Accept"
                                            class="sapUiSmallMarginTop"
                                        />
                                    </l:VerticalLayout>
                                </content>
                            </Panel>

                            <Panel id="panelEdmx" headerText="2. OData Metadata (EDMX)" width="auto" class="sapUiResponsiveMargin">
                                <content>
                                    <l:VerticalLayout id="vlEdmx">
                                        <Text id="txtEdmxInstr" text="Upload the EDMX metadata file from the OData service to populate target fields." class="sapUiSmallMarginBottom"/>
                                        <u:FileUploader
                                            id="fileUploaderEdmx"
                                            name="edmxUpload"
                                            uploadUrl=""
                                            tooltip="Upload EDMX"
                                            fileType="xml"
                                            placeholder="Select EDMX file..."
                                            style="Emphasized"
                                        />
                                        <Button
                                            id="btnLoadEdmx"
                                            text="Load Metadata"
                                            press="onUploadEdmx"
                                            type="Accept"
                                            class="sapUiSmallMarginTop"
                                        />
                                    </l:VerticalLayout>
                                </content>
                            </Panel>

                            <Panel id="panelXml" headerText="3. XML Invoice Sample" width="auto" class="sapUiResponsiveMargin">
                                <content>
                                    <l:VerticalLayout id="vlXml">
                                        <Text id="txtXmlInstr" text="Upload a sample XML invoice to populate available source fields (XPath)." class="sapUiSmallMarginBottom"/>

                                        <Label id="lblXmlRefTag" text="XML Reference Tag" class="sapUiTinyMarginTop"/>
                                        <Input 
                                            id="inputXmlRefTag"
                                            value="{xmlReferenceTag}"
                                            placeholder="Optional: Reference Tag for Embedded XML (e.g. Description)"
                                            width="100%"
                                            class="sapUiSmallMarginBottom"
                                        />
                                        <u:FileUploader
                                            id="fileUploaderXml"
                                            name="xmlUpload"
                                            uploadUrl=""
                                            tooltip="Upload XML Sample"
                                            fileType="xml"
                                            placeholder="Select XML file..."
                                            style="Emphasized"
                                        />
                                        <Button
                                            id="btnLoadXml"
                                            text="Load XML Fields"
                                            press="onUploadXmlSample"
                                            type="Accept"
                                            class="sapUiSmallMarginTop"
                                        />
                                    </l:VerticalLayout>
                                </content>
                            </Panel>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter id="itfAiPrompt" text="AI Prompt" key="aiPrompt">
                        <VBox id="vbAiPrompt" class="sapUiResponsiveMargin">
                            <OverflowToolbar id="otAiPrompt">
                                <Title id="titleAiPrompt" text="AI Prompt" level="H2" />
                                <ToolbarSpacer id="tsAiPrompt" />
                                <Button id="btnSavePrompt" text="Save Configuration" type="Emphasized" press="onSave" />
                            </OverflowToolbar>
                            <Panel id="panelAiPromptConfig" headerText="System Prompt Configuration" width="auto">
                                <content>
                                    <VBox id="vbAiPromptEditor">
                                        <HBox id="hbAiSettings" alignItems="Center" class="sapUiSmallMarginBottom">
                                            <VBox id="vbAiModel" class="sapUiMediumMarginEnd">
                                                <Label id="lblAiModel" text="{i18n>lblAiModel}" />
                                                <Input id="inputAiModel" value="{aiModel}" width="250px" placeholder="e.g. gpt-4o, gemini-1.5-pro" />
                                            </VBox>
                                            <VBox id="vbAiTemperature">
                                                <Label id="lblAiTemperature" text="{i18n>lblAiTemperature}" />
                                                <StepInput id="inputAiTemperature" value="{aiTemperature}" min="0" max="2" step="0.1" width="120px" />
                                            </VBox>
                                        </HBox>
                                        <Text id="txtAiPromptInfo" text="Define the system prompt that guides the AI Agent's behavior. This will override the default instructions but the target schema will still be appended automatically." class="sapUiSmallMarginBottom"/>
                                        <TextArea
                                            id="txtSystemPrompt"
                                            value="{systemPrompt}"
                                            rows="15"
                                            width="100%"
                                            placeholder="Enter custom system prompt here..."
                                            growing="true"
                                            growingMaxLines="30"
                                        />
                                    </VBox>
                                </content>
                            </Panel>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter id="itfCompanyCodes" text="{i18n>tabCompanyCodes}" key="companyCodes">
                        <Table
                            id="companyCodesTable"
                            items="{
                                path: 'to_CompanyCodes',
                                parameters: {
                                    $$updateGroupId: 'companyCodesGroup'
                                }
                            }"
                            mode="Delete"
                            delete="onDeleteCompanyCode"
                            width="auto"
                            class="sapUiResponsiveMargin"
                        >
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>companyCodesTitle} ({= ${to_CompanyCodes}.length })" />
                                    <ToolbarSpacer />
                                    <Button icon="sap-icon://save" text="{i18n>save}" type="Emphasized" press="onSaveCompanyCodes" />
                                    <Button icon="sap-icon://add" text="{i18n>addCompanyCode}" press="onAddCompanyCode" />
                                </OverflowToolbar>
                            </headerToolbar>
                            <columns>
                                <Column>
                                    <Text text="{i18n>colCode}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>colDescription}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Input value="{code}" placeholder="{i18n>phCode}" maxLength="4" />
                                        <Input value="{description}" placeholder="{i18n>phDescription}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter id="itfMapping" text="Field Mapping" key="mapping">
                        <VBox id="vbMapping" class="sapUiResponsiveMargin">
                            <OverflowToolbar id="otMapping">
                                <Title id="titleMapping" text="Field Mapping" level="H2" />
                                <ToolbarSpacer id="tsMapping" />
                                <SegmentedButton id="sbScenario" selectedKey="{viewModel>/currentScenario}" selectionChange="onScenarioChange" class="sapUiTinyMarginEnd">
                                    <items>
                                        <SegmentedButtonItem id="sbiMM" key="MM" text="Merchandise (MM)" />
                                        <SegmentedButtonItem id="sbiFI" key="FI" text="Financial (FI)" />
                                    </items>
                                </SegmentedButton>
                                <Button id="btnExport" text="Export" icon="sap-icon://download" press="onExportMappings" />
                                <Button id="btnImport" text="Import" icon="sap-icon://upload" press="onImportMappings" />
                                <Button id="btnAddCustomField" text="Add Custom Field" icon="sap-icon://add" press="onAddCustomField" />
                                <Button id="btnDeleteCountry" text="Delete Country" icon="sap-icon://delete" type="Reject" press="onDelete" />
                                <Button id="btnSaveConfig" text="Save Configuration" type="Emphasized" press="onSave" />
                            </OverflowToolbar>

                            <!-- System Fields Panel Removed as per request -->

                            <Panel id="pnlDoxFields" headerText="Document AI Fields (Standard)" width="auto" expandable="true" expanded="true" class="sapUiTinyMarginTop">
                                <Table
                                    id="mappingTableDox"
                                    items="{
                                        path: 'mappingModel>/items',
                                        filters: [{
                                            path: 'documentAIField_sourceType',
                                            operator: 'EQ',
                                            value1: 'DOX'
                                        }],
                                        sorter: {
                                            path: 'displayOrder'
                                        }
                                    }"
                                    growing="true"
                                    growingThreshold="50"
                                    width="auto"
                                >
                                    <columns>

                                        <Column id="colFieldDox" width="20%">
                                            <Text id="txtFieldDox" text="Document AI Field" />
                                        </Column>
                                        <Column id="colVisibleDox" width="8%">
                                            <Text id="txtVisibleDox" text="Visible" />
                                        </Column>
                                        <Column id="colActiveDox" width="8%">
                                            <Text id="txtActiveDox" text="Active" />
                                        </Column>
                                        <Column id="colMandatoryDox" width="8%">
                                            <Text id="txtMandatoryDox" text="Mandatory" />
                                        </Column>
                                        <Column id="colToBeControlledDox" width="10%">
                                            <Text id="txtToBeControlledDox" text="To Be Controlled" />
                                        </Column>
                                        <Column id="colEditableDox" width="8%">
                                            <Text id="txtEditableDox" text="Editable" />
                                        </Column>
                                        <Column id="colCustomLabelDox" width="20%">
                                            <Text id="txtCustomLabelDox" text="Custom Label" />
                                        </Column>
                                        <Column id="colSearchHelpDox" width="15%">
                                            <Text id="txtSearchHelpDox" text="Search Help" />
                                        </Column>
                                        <Column id="colConfigurationDox" width="18%">
                                            <Text id="txtConfigurationDox" text="Configuration" />
                                        </Column>
                                        <Column id="colActionsDox" width="5%">
                                            <Text id="txtActionsDox" text="Actions" />

                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="cliDox">
                                            <cells>
                                                <VBox id="vbDoxFieldInfo">
                                                    <Text id="txtDoxFieldName" text="{mappingModel>documentAIField_fieldName}" class="sapMTextBold" />
                                                    <HBox id="hbDoxFieldMeta">
                                                        <Select
                                                            id="selDoxFieldType"
                                                            selectedKey="{mappingModel>documentAIField_fieldType}"
                                                            items="{path: '/FieldTypes', sorter: {path: 'name'}}"
                                                            change="onDoxFieldTypeChange"
                                                            class="sapUiTinyMarginTop sapUiTinyMarginEnd">
                                                            <core:Item key="{code}" text="{name}" />
                                                        </Select>
                                                        <ObjectStatus
                                                            id="osDoxSource"
                                                            text="{mappingModel>documentAIField_sourceType}"
                                                            state="{= ${mappingModel>documentAIField_sourceType} === 'XML' ? 'Information' : 'None' }"
                                                            inverted="true"
                                                            class="sapUiTinyMarginTop"
                                                        />
                                                    </HBox>
                                                </VBox>
                                                
                                                <CheckBox id="cbDoxVisible" selected="{mappingModel>visible}" />
                                                <CheckBox id="cbDoxActive" selected="{mappingModel>active}" />
                                                
                                                <CheckBox id="cbDoxMandatory" selected="{mappingModel>mandatory}" enabled="{mappingModel>visible}" />
                                                <CheckBox id="cbDoxToBeControlled" selected="{mappingModel>toBeControlled}" enabled="{mappingModel>visible}" />
                                                
                                                <CheckBox id="cbDoxEditable" selected="{mappingModel>editable}" enabled="{mappingModel>visible}" />
                                                
                                                <Input id="inDoxLabel" value="{mappingModel>customLabel}" placeholder="Override..." enabled="{mappingModel>visible}" />
                                                
                                                <HBox id="hbSearchHelpDox" width="100%" alignItems="Center">
                                                    <ComboBox
                                                        id="cbSearchHelpDox"
                                                        selectedKey="{mappingModel>searchHelpFunction_id}"
                                                        items="{
                                                            path: '/ConversionFunctions',
                                                            sorter: { path: 'name' },
                                                            length: 2000,
                                                            templateShareable: true
                                                        }"
                                                        enabled="{mappingModel>visible}"
                                                        width="100%"
                                                    >
                                                        <core:Item key="{id}" text="{name}" />
                                                    </ComboBox>
                                                    <Button
                                                        icon="sap-icon://chain-link"
                                                        type="Transparent"
                                                        tooltip="Map Search Help Input Parameters"
                                                        press="onOpenSearchHelpMapping"
                                                        enabled="{= ${mappingModel>searchHelpFunction_id} ? true : false }"
                                                        class="sapUiTinyMarginBegin"
                                                    />
                                                </HBox>
                                                
                                                <Button
                                                    id="btnDoxEdit"
                                                    text="{mappingModel>validationText}"
                                                    type="{mappingModel>validationState}"
                                                    icon="{mappingModel>btnIcon}"
                                                    press="onEditMapping"
                                                    enabled="true"
                                                />
                                                
                                                <Button
                                                    id="btnDoxDelete"
                                                    icon="sap-icon://delete"
                                                    type="Reject"
                                                    press="onDeleteField"
                                                    tooltip="Delete Field"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>

                            <Panel id="pnlXmlFields" headerText="Document AI Fields (XML)" width="auto" expandable="true" expanded="true" class="sapUiTinyMarginTop">
                                <headerToolbar>
                                    <Toolbar id="tbXmlFields">
                                        <Title id="titleXmlFields" text="XML Fields (XPath)" />
                                        <ToolbarSpacer id="tsXmlFields" />
                                        
                                        <Label id="lblXmlPoRef" text="PO Tag (Scenario):" class="sapUiTinyMarginEnd" />
                                        <ComboBox
                                            id="selectXmlPoRefTag"
                                            selectedKey="{xmlPoReferenceTag}"
                                            showClearIcon="true"
                                            items="{
                                                path: 'mappingModel>/items',
                                                filters: [{
                                                    path: 'documentAIField_sourceType',
                                                    operator: 'EQ',
                                                    value1: 'XML'
                                                }],
                                                sorter: { path: 'displayOrder' }
                                            }"
                                            width="180px"
                                            class="sapUiTinyMarginEnd"
                                        >
                                            <core:Item id="itXmlPoRef" key="{mappingModel>documentAIField_fieldName}" text="{mappingModel>documentAIField_fieldName}" />
                                        </ComboBox>

                                        <Label id="lblXmlVendorTag" text="Vendor Tag:" class="sapUiTinyMarginEnd" />
                                        <ComboBox
                                            id="selectXmlVendorTag"
                                            selectedKey="{xmlVendorTag}"
                                            showClearIcon="true"
                                            items="{
                                                path: 'mappingModel>/items',
                                                filters: [{
                                                    path: 'documentAIField_sourceType',
                                                    operator: 'EQ',
                                                    value1: 'XML'
                                                }],
                                                sorter: { path: 'displayOrder' }
                                            }"
                                            width="180px"
                                            class="sapUiTinyMarginEnd"
                                        >
                                            <core:Item id="itXmlVendorTag" key="{mappingModel>documentAIField_fieldName}" text="{mappingModel>documentAIField_fieldName}" />
                                        </ComboBox>

                                        <Label id="lblXmlInvoiceNumberTag" text="Invoice Tag:" class="sapUiTinyMarginEnd" />
                                        <ComboBox
                                            id="selectXmlInvoiceNumberTag"
                                            selectedKey="{xmlInvoiceNumberTag}"
                                            showClearIcon="true"
                                            items="{
                                                path: 'mappingModel>/items',
                                                filters: [{
                                                    path: 'documentAIField_sourceType',
                                                    operator: 'EQ',
                                                    value1: 'XML'
                                                }],
                                                sorter: { path: 'displayOrder' }
                                            }"
                                            width="180px"
                                            class="sapUiTinyMarginEnd"
                                        >
                                            <core:Item id="itXmlInvoiceNumberTag" key="{mappingModel>documentAIField_fieldName}" text="{mappingModel>documentAIField_fieldName}" />
                                        </ComboBox>

                                        <Label id="lblXmlCompanyCodeTag" text="Company Code Tag:" class="sapUiTinyMarginEnd" />
                                        <ComboBox
                                            id="selectXmlCompanyCodeTag"
                                            selectedKey="{xmlCompanyCodeTag}"
                                            showClearIcon="true"
                                            items="{
                                                path: 'mappingModel>/items',
                                                filters: [{
                                                    path: 'documentAIField_sourceType',
                                                    operator: 'EQ',
                                                    value1: 'XML'
                                                }],
                                                sorter: { path: 'displayOrder' }
                                            }"
                                            width="180px"
                                        >
                                            <core:Item id="itXmlCompanyCodeTag" key="{mappingModel>documentAIField_fieldName}" text="{mappingModel>documentAIField_fieldName}" />
                                        </ComboBox>
                                    </Toolbar>
                                </headerToolbar>
                                <Table
                                    id="mappingTableXml"
                                    items="{
                                        path: 'mappingModel>/items',
                                        filters: [{
                                            path: 'documentAIField_sourceType',
                                            operator: 'EQ',
                                            value1: 'XML'
                                        }],
                                        sorter: {
                                            path: 'displayOrder'
                                        }
                                    }"
                                    growing="true"
                                    growingThreshold="50"
                                    width="auto"
                                >
                                    <columns>

                                        <Column id="colFieldXml" width="20%">
                                            <Text id="txtFieldXml" text="XML Field (XPath)" />
                                        </Column>
                                        <Column id="colVisibleXml" width="8%">
                                            <Text id="txtVisibleXml" text="Visible" />
                                        </Column>
                                        <Column id="colActiveXml" width="8%">
                                            <Text id="txtActiveXml" text="Active" />
                                        </Column>
                                        <Column id="colMandatoryXml" width="8%">
                                            <Text id="txtMandatoryXml" text="Mandatory" />
                                        </Column>
                                        <Column id="colToBeControlledXml" width="10%">
                                            <Text id="txtToBeControlledXml" text="To Be Controlled" />
                                        </Column>
                                        <Column id="colEditableXml" width="8%">
                                            <Text id="txtEditableXml" text="Editable" />
                                        </Column>
                                        <Column id="colCustomLabelXml" width="20%">
                                            <Text id="txtCustomLabelXml" text="Custom Label" />
                                        </Column>
                                        <Column id="colSearchHelpXml" width="15%">
                                            <Text id="txtSearchHelpXml" text="Search Help" />
                                        </Column>
                                        <Column id="colConfigurationXml" width="18%">
                                            <Text id="txtConfigurationXml" text="Configuration" />
                                        </Column>
                                        <Column id="colActionsXml" width="5%">
                                            <Text id="txtActionsXml" text="Actions" />

                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="cliXml">
                                            <cells>
                                                <VBox id="vbXmlFieldInfo">
                                                    <Text id="txtXmlFieldName" text="{mappingModel>documentAIField_fieldName}" class="sapMTextBold" />
                                                    <HBox id="hbXmlFieldMeta">
                                                        <Select
                                                            id="selXmlFieldType"
                                                            selectedKey="{mappingModel>documentAIField_fieldType}"
                                                            items="{path: '/FieldTypes', sorter: {path: 'name'}}"
                                                            change="onXmlFieldTypeChange"
                                                            class="sapUiTinyMarginTop sapUiTinyMarginEnd">
                                                            <core:Item key="{code}" text="{name}" />
                                                        </Select>
                                                        <ObjectStatus
                                                            id="osXmlSource"
                                                            text="{mappingModel>documentAIField_sourceType}"
                                                            state="Information"
                                                            inverted="true"
                                                            class="sapUiTinyMarginTop"
                                                        />
                                                    </HBox>
                                                </VBox>
                                                
                                                <CheckBox id="cbXmlVisible" selected="{mappingModel>visible}" />
                                                <CheckBox id="cbXmlActive" selected="{mappingModel>active}" />
                                                
                                                <CheckBox id="cbXmlMandatory" selected="{mappingModel>mandatory}" enabled="{mappingModel>visible}" />
                                                <CheckBox id="cbXmlToBeControlled" selected="{mappingModel>toBeControlled}" enabled="{mappingModel>visible}" />
                                                
                                                <CheckBox id="cbXmlEditable" selected="{mappingModel>editable}" enabled="{mappingModel>visible}" />
                                                
                                                <Input id="inXmlLabel" value="{mappingModel>customLabel}" placeholder="Override..." enabled="{mappingModel>visible}" />
                                                
                                                <HBox id="hbSearchHelpXml" width="100%" alignItems="Center">
                                                    <ComboBox
                                                        id="cbSearchHelpXml"
                                                        selectedKey="{mappingModel>searchHelpFunction_id}"
                                                        items="{
                                                            path: '/ConversionFunctions',
                                                            sorter: { path: 'name' },
                                                            length: 2000,
                                                            templateShareable: true
                                                        }"
                                                        enabled="{mappingModel>visible}"
                                                        width="100%"
                                                    >
                                                        <core:Item key="{id}" text="{name}" />
                                                    </ComboBox>
                                                    <Button
                                                        id="btnMapSearchHelpXml"
                                                        icon="sap-icon://chain-link"
                                                        type="Transparent"
                                                        tooltip="Map Search Help Input Parameters"
                                                        press="onOpenSearchHelpMapping"
                                                        enabled="{= ${mappingModel>searchHelpFunction_id} ? true : false }"
                                                        class="sapUiTinyMarginBegin"
                                                    />
                                                </HBox>
                                                
                                                <Button
                                                    id="btnXmlEdit"
                                                    text="{mappingModel>validationText}"
                                                    type="{mappingModel>validationState}"
                                                    icon="{mappingModel>btnIcon}"
                                                    press="onEditMapping"
                                                    enabled="true"
                                                />
                                                
                                                <Button
                                                    id="btnXmlDelete"
                                                    icon="sap-icon://delete"
                                                    type="Reject"
                                                    press="onDeleteField"
                                                    tooltip="Delete Field"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
