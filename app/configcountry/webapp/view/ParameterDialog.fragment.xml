<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
    <Dialog title="{i18n>titParameterDialog}" contentWidth="600px">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="{i18n>titParameterDialog}" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://add" text="{i18n>btnAddParam}" press="onAddParameter" />
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiSmallMargin" id="vboxParams">
                <!-- Dynamic Content will be added here by Controller -->
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>apply}" type="Emphasized" press="onSaveParams" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press="onCancelParams" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
