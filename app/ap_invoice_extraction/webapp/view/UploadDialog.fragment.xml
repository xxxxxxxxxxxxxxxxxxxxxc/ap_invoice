                <Label text="{i18n>fileLabel}" required="true" class="sapUiSmallMarginTop" />
                <u:FileUploader
                    id="fileUploaderDialog"
                    name="myFileUpload"
                    uploadUrl=""
                    tooltip="{i18n>placeholderFileUploader}"
                    fileType="pdf,xml,zip"
                    placeholder="{i18n>selectFilePlaceholder}"
                    style="Emphasized"
                    width="100%"
