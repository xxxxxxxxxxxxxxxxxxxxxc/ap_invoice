<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Lightweight, non-modal chat: anchored to the toolbar button, the app stays usable -->
    <Popover
        id="chatbotPopover"
        title="{i18n>chatbotTitle}"
        placement="Bottom"
        modal="false"
        resizable="true"
        contentWidth="22rem"
        contentHeight="24rem"
        initialFocus="chatbotInput"
        class="apiChatPopover"
        busy="{chatbot>/busy}"
        busyIndicatorDelay="0">
        <content>
            <ScrollContainer
                id="chatbotScroll"
                height="100%"
                width="100%"
                vertical="true"
                class="apiChatScroll">
                <List
                    id="chatbotMessageList"
                    showSeparators="None"
                    showNoData="false"
                    backgroundDesign="Transparent"
                    items="{chatbot>/messages}">
                    <CustomListItem type="Inactive" class="apiChatItem">
                        <VBox
                            width="100%"
                            alignItems="{= ${chatbot>author} === 'user' ? 'End' : 'Start' }"
                            class="sapUiTinyMarginBottom">
                            <HBox
                                alignItems="End"
                                direction="{= ${chatbot>author} === 'user' ? 'RowReverse' : 'Row' }">
                                <Avatar
                                    src="{= ${chatbot>author} === 'user' ? 'sap-icon://person-placeholder' : 'sap-icon://ai' }"
                                    displaySize="XS"
                                    displayShape="Circle"
                                    backgroundColor="{= ${chatbot>author} === 'user' ? 'Accent6' : 'Accent10' }"
                                    class="apiChatAvatar" />
                                <VBox class="{= ${chatbot>author} === 'user' ? 'apiChatBubble apiChatBubbleUser' : 'apiChatBubble apiChatBubbleBot' }">
                                    <Text text="{chatbot>text}" />
                                </VBox>
                            </HBox>
                            <Text
                                text="{chatbot>time}"
                                class="apiChatTime" />
                        </VBox>
                    </CustomListItem>
                </List>
            </ScrollContainer>
        </content>
        <footer>
            <Toolbar id="chatbotFooter" class="apiChatFooter">
                <Input
                    id="chatbotInput"
                    width="100%"
                    placeholder="{i18n>chatbotPlaceholder}"
                    value="{chatbot>/draft}"
                    submit="onChatbotSend" />
                <Button
                    id="chatbotSendButton"
                    icon="sap-icon://paper-plane"
                    type="Transparent"
                    tooltip="{i18n>chatbotSend}"
                    press="onChatbotSend" />
            </Toolbar>
        </footer>
    </Popover>
</core:FragmentDefinition>
