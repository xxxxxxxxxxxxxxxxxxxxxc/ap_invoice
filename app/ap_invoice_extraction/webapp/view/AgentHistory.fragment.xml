<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="agentHistoryDialog" title="{i18n>agentHistoryTitle}" contentWidth="600px" contentHeight="500px" draggable="true" resizable="true">
        <content>
            <List
                id="agentLogList"
                items="{agentLog>/logs}"
                noDataText="{i18n>noAgentHistory}">
                <FeedListItem
                    id="agentLogItem"
                    sender="{agentLog>title}"
                    icon="{agentLog>icon}"
                    info="{agentLog>status}"
                    timestamp="{agentLog>timestamp}"
                    text="{agentLog>text}"
                    convertLinksToAnchorTags="ProtocolOnly"
                    maxCharacters="150"
                />
            </List>
        </content>
        <buttons>
            <Button id="agentHistoryCloseBtn" text="{i18n>close}" press="onCloseExecutionHistory"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
