<mvc:View controllerName="knowledgebase.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified">
    <Page id="pageMain" title="{i18n>appTitle}" busy="{local>/busy}">
        <content>
            <MessageStrip text="{i18n>infoText}" type="Information" showIcon="true" class="sapUiSmallMargin"/>
            <Table id="table" mode="SingleSelectLeft" growing="true" growingThreshold="50"
                noDataText="{i18n>noData}" selectionChange=".onSelectionChange"
                items="{
                    path: '/KnowledgeDocuments',
                    sorter: { path: 'createdAt', descending: true },
                    events: { dataReceived: '.onDataReceived' }
                }">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>documents}" level="H2"/>
                        <ToolbarSpacer/>
                        <SearchField width="25%" search=".onSearch" placeholder="{i18n>searchPlaceholder}"/>
                        <u:FileUploader id="fileUploader" fileType="pdf,docx,md" buttonOnly="true"
                            buttonText="{i18n>upload}" icon="sap-icon://upload" style="Emphasized"
                            sameFilenameAllowed="true" change=".onFileSelected"
                            typeMissmatch=".onTypeMismatch"/>
                        <Button id="btnReprocess" icon="sap-icon://refresh" text="{i18n>reprocess}"
                            press=".onReprocess" enabled="{local>/hasSelection}"/>
                        <Button id="btnDelete" icon="sap-icon://delete" text="{i18n>delete}"
                            press=".onDelete" type="Reject" enabled="{local>/hasSelection}"/>
                        <Button icon="sap-icon://synchronize" tooltip="{i18n>refresh}" press=".onRefresh"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="{i18n>fileName}"/>
                    </Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>fileSize}"/>
                    </Column>
                    <Column>
                        <Text text="{i18n>status}"/>
                    </Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>chunkCount}"/>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>uploadedBy}"/>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>error}"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{fileName}"
                                text="{path: 'mimeType', formatter: '.formatter.fileType'}"/>
                            <Text text="{path: 'fileSize', targetType: 'any', formatter: '.formatter.fileSize'}"/>
                            <ObjectStatus
                                text="{path: 'status', formatter: '.formatter.statusText'}"
                                state="{path: 'status', formatter: '.formatter.statusState'}"
                                icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                            <Text text="{chunkCount}"/>
                            <ObjectIdentifier title="{createdBy}" text="{createdAt}"/>
                            <Text text="{errorMessage}" maxLines="3"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
