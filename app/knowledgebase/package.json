{
  "name": "knowledgebase",
  "version": "1.0.0",
  "description": "Knowledge base of the chatbot: upload of DOCX, PDF and Markdown documents",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "scripts": {
    "start": "fiori run --open 'index.html?sap-client=001'",
    "start-local": "fiori run --config ./ui5-local.yaml --open 'index.html?sap-client=001'",
    "build": "npm run build:cf",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
    "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf"
  },
  "devDependencies": {
    "@ui5/cli": "^3.0.0",
    "@sap/ux-ui5-tooling": "^1.0.0",
    "ui5-task-zipper": "^3.0.0"
  }
}
